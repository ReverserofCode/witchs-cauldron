frontend_local

# OS/editor noise
.DS_Store
Thumbs.db
*.swp
*.swo

# dependencies and build outputs
node_modules/
**/node_modules/
.next/
**/.next/
dist/
**/dist/
coverage/
**/coverage/
*.tsbuildinfo
**/tsconfig.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.agent-logs/
.superpowers/
.worktrees/

# local agent settings
.claude/settings.local.json
frontend/.claude/settings.local.json

# python cache
**/__pycache__/
*.py[cod]

# local clip artifacts (keep frontend/public/clips tracked)
/chizzkData/clips/
/clips/

# frontend clip temp artifacts
frontend/public/clips/__trash/
frontend/public/clips/__tslist_*.txt

# runtime-generated clip artifacts (do not track)
/shared/clips/*.mp4
/shared/clips/*.webm
/shared/clips/*.m4v
/frontend/public/clips/clip_*.mp4
/frontend/public/clips/clip_*.webm
/frontend/public/clips/clip_*.m4v

# playwright MCP
.playwright-mcp/
.playwright-cli/
**/.playwright-cli/
playwright-screenshots/
frontend/playwright-screenshots/
/output/

# local environment files
.env
.env.local
.env.*.local

# local secrets used by operator scripts
.secrets/
