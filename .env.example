# Frontend/content
YOUTUBE_API_KEY=your_youtube_api_key

# Analytics database
ANALYTICS_DATABASE_URL=postgres://analytics:analytics@analytics-db:5432/analytics
ANALYTICS_PUBLIC=true

# Admin basic auth (required in production for /admin/* and /api/analytics/stats)
ADMIN_BASIC_AUTH_USERNAME=admin
ADMIN_BASIC_AUTH_PASSWORD=change-this-before-deploy

# Backend/internal URLs
BACKEND_URL=http://backend:8000
NEXT_TELEMETRY_DISABLED=1
COLLECT_API_KEY=

# Backend clip automation
CLIP_AUTO_COLLECT_ENABLED=true
CLIP_AUTO_COLLECT_INTERVAL_MINUTES=720
CLIP_AUTO_COLLECT_RUN_ON_STARTUP=false
CLIP_AUTO_COLLECT_STARTUP_DELAY_SECONDS=60
CLIP_AUTO_COLLECT_MAX_CLIPS=2
CLIP_AUTO_COLLECT_FILTER_TYPE=ALL
CLIP_AUTO_COLLECT_ORDER_TYPE=RECENT
CLIP_AUTO_COLLECT_FAILURE_COOLDOWN_MINUTES=720

# GitHub Actions manual clip refresh
# Repository secret should match COLLECT_API_KEY when COLLECT_API_KEY is set.
CLIP_REFRESH_BASE_URL=https://moingfans.com

# Optional runtime credentials
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
